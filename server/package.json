{
  "name": "argos-server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "test": "tsx --test test/*.test.ts",
    "demo": "tsx src/demo.ts",
    "keys": "tsx src/keys-cli.ts",
    "contracts": "tsx src/generate-contracts.ts",
    "interop:prepare": "tsx src/interop.ts",
    "interop:verify": "tsx src/interop.ts --verify"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.7",
    "fastify": "5.12.7",
    "jose": "6.2.13",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "linkedom": "0.18.14",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
